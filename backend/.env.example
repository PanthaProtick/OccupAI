DATA_SOURCE=mock
APP_ENVIRONMENT=development
MOCK_DATA_DIR=mock/generated
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_COOKIE_NAME=occupai_session
AUTH_SESSION_TTL_SECONDS=3600
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Replace with a long random secret in every non-local environment.
AUTH_SESSION_PEPPER=occupai-local-development-only-change-me
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite:///./data/occupai.db
SQLITE_BUSY_TIMEOUT_MS=5000
RAW_SAMPLE_INTERVAL_SECONDS=10
RAW_SAMPLE_RETENTION_DAYS=30
AGGREGATE_RETENTION_DAYS=365
RETENTION_BATCH_SIZE=1000
MODEL_SERVER_URL=http://127.0.0.1:8001
MODEL_SERVER_TIMEOUT_SECONDS=2
MODEL_SERVER_POLL_INTERVAL_SECONDS=2
INGESTION_ENABLED=false
LIVE_CAMERA_IDS=cam_001,cam_002,cam_003
MAINTENANCE_ENABLED=false
MAINTENANCE_INTERVAL_SECONDS=60
SIMULATION_ENABLED=false
SIMULATION_TICK_INTERVAL_SECONDS=5

